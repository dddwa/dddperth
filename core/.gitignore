# Wrangler local secrets — legacy website path, the fork-owned path, and the
# conference-stub path used when ddd-core runs standalone. The e2e suite's
# wrangler config (wrangler/e2e/e2e.jsonc) IS committed; only its generated
# vars and local miniflare state are ignored — e2e/start-dev-server.mjs
# rewrites .dev.vars on every run.
website/.dev.vars
conference/wrangler/.dev.vars
conference/wrangler/.wrangler/
conference/wrangler/e2e/.dev.vars
conference/wrangler/e2e/.wrangler/
conference-stub/wrangler/.dev.vars
conference-stub/wrangler/e2e/.dev.vars
conference-stub/wrangler/e2e/.wrangler/

# Playwright output — traces, failure screenshots and HTML reports are
# regenerated on every run and can be large.
test-results/
playwright-report/
blob-report/


qa

.nx/self-healing
conference-stub/wrangler/.wrangler/
