{
    "name": "website",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "website",
    "projectType": "application",
    "tags": [],
    "targets": {
        "setup-temporal-browsers": {
            "executor": "nx:run-commands",
            "options": {
                "command": "pnpm exec playwright install chromium firefox webkit",
                "cwd": "core/website"
            }
        },
        "temporal-check": {
            "executor": "nx:run-commands",
            "options": {
                "command": "node scripts/check-temporal-runtime.mjs",
                "cwd": "core/website"
            }
        },
        "lint": {
            "inputs": ["default", "^default", "{workspaceRoot}/eslint.config.mjs", "{projectRoot}/../eslint.config.mjs", "{projectRoot}/eslint.config.mjs", "{projectRoot}/../eslint-rules/**/*", {"externalDependencies": ["eslint"]}]
        },
        "panda": {
            "executor": "nx:run-commands",
            "options": {
                "command": [
                    {
                        "command": "pnpm panda",
                        "forwardAllArgs": true
                    }
                ],
                "parallel": false,
                "cwd": "core/website"
            }
        },
        "parkui": {
            "executor": "nx:run-commands",
            "options": {
                "commands": [
                    {
                        "command": "pnpm dlx @park-ui/cli@1.0.1",
                        "forwardAllArgs": true
                    }
                ],
                "parallel": false,
                "cwd": "core/website"
            }
        },
        "setup-panda": {
            "executor": "nx:run-commands",
            "// parallelism": "All three setup targets generate into website/, and `react-router typegen` clears and rewrites .react-router/types/ as it goes. Run concurrently (which `setup` did, having no ordering in its dependsOn) that rmdir races another generator repopulating the tree, and CI dies with ENOTEMPTY before the suite runs a single test. It hit three PRs in a row, each passing on a plain re-run, which is exactly what a race looks like.",
            "parallelism": false,
            "options": {
                "command": "pnpm panda setup",
                "cwd": "core/website"
            }
        },
        "setup-react-router": {
            "executor": "nx:run-commands",
            "parallelism": false,
            "options": {
                "command": "pnpm react-router typegen",
                "cwd": "core/website"
            }
        },
        "setup-cf-types": {
            "executor": "nx:run-commands",
            "parallelism": false,
            "options": {
                "command": "pnpm exec wrangler types -c ../../conference/wrangler/local.jsonc",
                "cwd": "core/website"
            }
        },
        "setup": {
            "executor": "nx:noop",
            "dependsOn": ["setup-panda", "setup-react-router", "setup-cf-types"]
        },
        "typecheck": {
            "executor": "nx:run-commands",
            "options": {
                "command": "tsc --noEmit",
                "cwd": "core/website"
            },
            "dependsOn": ["setup"]
        },
        "dev": {
            "executor": "nx:run-commands",
            "options": {
                "command": "pnpm vite",
                "cwd": "core/website"
            }
        },
        "wrangler-dev": {
            "executor": "nx:run-commands",
            "options": {
                "command": "wrangler dev -c ../../conference/wrangler/local.jsonc",
                "cwd": "core/website",
                "tty": true
            }
        },
        "wrangler": {
            "executor": "nx:run-commands",
            "options": {
                "commands": [
                    {
                        "command": "pnpm exec wrangler",
                        "forwardAllArgs": true
                    }
                ],
                "parallel": false,
                "cwd": "core/website",
                "tty": true
            }
        },
        "build": {
            "executor": "nx:run-commands",
            "cache": true,
            "inputs": [
                "{projectRoot}/app/**/*.*",
                "{projectRoot}/workers/**/*.*",
                "{projectRoot}/vite-plugins/**/*.*",
                "{projectRoot}/vite.config.ts",
                "^production"
            ],
            "outputs": ["{projectRoot}/build/**/*.*"],
            "options": {
                "command": "react-router build",
                "cwd": "core/website"
            },
            "dependsOn": ["setup"]
        },
        "test": {
            "executor": "nx:run-commands",
            "cache": true,
            "inputs": [
                "default",
                "{projectRoot}/../eslint-rules/**/*",
                "^production",
                {
                    "dependentTasksOutputFiles": "**/build/server/**/*.js"
                },
                {
                    "externalDependencies": ["vitest"]
                },
                {
                    "env": "CI"
                }
            ],
            "outputs": ["{workspaceRoot}/coverage/website"],
            "options": {
                "command": "vitest run",
                "cwd": "core/website"
            },
            "dependsOn": ["build"]
        },
        "e2e": {
            "executor": "nx:run-commands",
            "inputs": [
                "default",
                "^production",
                {
                    "externalDependencies": ["@playwright/test", "@axe-core/playwright"]
                },
                {
                    "env": "CI"
                }
            ],
            "outputs": ["{projectRoot}/playwright-report", "{projectRoot}/test-results"],
            "options": {
                "command": "playwright test --project=chromium --project=chromium-light",
                "cwd": "core/website"
            },
            "dependsOn": ["setup"]
        },
        "e2e-visual": {
            "executor": "nx:run-commands",
            "inputs": [
                "default",
                "^production",
                {
                    "externalDependencies": ["@playwright/test"]
                },
                {
                    "env": "CI"
                }
            ],
            "outputs": ["{projectRoot}/playwright-report", "{projectRoot}/test-results"],
            "options": {
                "command": "playwright test e2e/visual.spec.ts",
                "cwd": "core/website"
            },
            "dependsOn": ["setup"]
        },
        "deploy": {
            "executor": "nx:run-commands",
            "options": {
                "command": "wrangler deploy -c ../../conference/wrangler/local.jsonc",
                "cwd": "core/website",
                "tty": true
            },
            "dependsOn": ["build"]
        },
        "deploy-staging": {
            "executor": "nx:run-commands",
            "options": {
                "command": "pnpm nx build website && node scripts/prepare-deploy-config.mjs staging && wrangler deploy",
                "cwd": "core/website",
                "tty": true
            }
        },
        "deploy-production": {
            "executor": "nx:run-commands",
            "options": {
                "command": "pnpm nx build website && node scripts/prepare-deploy-config.mjs production && wrangler deploy",
                "cwd": "core/website",
                "tty": true
            }
        },
        "d1-migrate-local": {
            "executor": "nx:run-commands",
            "options": {
                "command": "node scripts/manifest-d1-migrate.mjs local",
                "cwd": "core/website"
            }
        },
        "d1-migrate-staging": {
            "executor": "nx:run-commands",
            "options": {
                "command": "node scripts/manifest-d1-migrate.mjs staging",
                "cwd": "core/website",
                "tty": true
            }
        },
        "d1-migrate-production": {
            "executor": "nx:run-commands",
            "options": {
                "command": "node scripts/manifest-d1-migrate.mjs production",
                "cwd": "core/website",
                "tty": true
            }
        }
    }
}
